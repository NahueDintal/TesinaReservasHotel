<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <!-- Panel izquierdo (verde oscuro) -->
    <left>
        <VBox nodeOrientation="RIGHT_TO_LEFT" prefWidth="300.0" style="-fx-background-color: #3E864D; -fx-padding: 20;">
         <ImageView fitHeight="154.0" fitWidth="260.0" pickOnBounds="true" preserveRatio="true" />
         <ToggleButton mnemonicParsing="false" prefHeight="53.0" prefWidth="315.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 10 15; -fx-background-radius: 5;" text="Planilla de reserva" />
         <ToggleButton mnemonicParsing="false" prefHeight="53.0" prefWidth="315.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 10 15; -fx-background-radius: 5;" text="Reservas" />
         <ToggleButton mnemonicParsing="false" prefHeight="53.0" prefWidth="315.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 10 15; -fx-background-radius: 5;" text="Habitaciones" />
         <ToggleButton mnemonicParsing="false" prefHeight="53.0" prefWidth="315.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 10 15; -fx-background-radius: 5;" text="Clientes" />
         <ToggleButton mnemonicParsing="false" prefHeight="53.0" prefWidth="315.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 10 15; -fx-background-radius: 5;" text="Reportes" />
         <ToggleButton mnemonicParsing="false" prefHeight="53.0" prefWidth="315.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 10 15; -fx-background-radius: 5;" text="Configuración" />
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
        </VBox>
    </left>

    <!-- Área central (fondo blanco) -->
    <center>
        <AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: white;" BorderPane.alignment="TOP_RIGHT" />
    </center>
</BorderPane>
