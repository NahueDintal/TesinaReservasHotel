<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Propiedades reutilizables -->
    <property name="LOG_DIR" value="logs" />
    <property name="LOG_FILE" value="${LOG_DIR}/app.log" />
    <property name="PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />

    <!-- 1. Appender de consola -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 2. Appender de archivo con rotación por fecha y tamaño -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- Archivo actual -->
        <file>${LOG_FILE}</file>

        <!-- Política de rotación: crea un archivo nuevo cada día y/o cuando supera el tamaño -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Nombre de los archivos rotados: app.2025-03-07.0.log -->
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- Tamaño máximo por archivo antes de rotar -->
            <maxFileSize>10MB</maxFileSize>
            <!-- Conservar logs de los últimos 30 días -->
            <maxHistory>30</maxHistory>
            <!-- Tamaño total de todos los logs (1GB) -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 3. (Opcional) Niveles específicos para tus paquetes -->
    <logger name="repositories" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <logger name="controllers" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <!-- Logger raíz: nivel INFO por defecto -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>
