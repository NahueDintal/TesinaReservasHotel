<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.CancellationByCustomerOriginController"
            styleClass="content-main">

    <top>
        <VBox spacing="12">
            <padding><Insets top="18" right="18" bottom="12" left="18"/></padding>

            <Label text="Cancelación por origen del cliente" styleClass="report-title"/>
            <Label text="Probabilidad empírica P(cancelar | origen del cliente) con IC 95% de Wilson."
                   styleClass="report-subtitle"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Desde:"/>
                <DatePicker fx:id="fromDatePicker" prefWidth="140"/>
                <Label text="Hasta:"/>
                <DatePicker fx:id="toDatePicker" prefWidth="140"/>
                <Label text="Canal:"/>
                <ComboBox fx:id="channelComboBox" prefWidth="170"/>
                <Button fx:id="calculateButton" text="Calcular" onAction="#onCalculate"
                        defaultButton="true" styleClass="btn-primary"/>
                <Button fx:id="exportButton" text="Exportar CSV" onAction="#onExport" styleClass="btn-secondary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="clearButton" text="Limpiar" onAction="#onClear" styleClass="btn-secondary"/>
            </HBox>

            <GridPane hgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.34"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0" spacing="4" styleClass="report-card">
                    <Label text="Total de reservas" styleClass="kpi-label"/>
                    <Label fx:id="totalReservationsLabel" text="—" styleClass="kpi-value"/>
                </VBox>

                <VBox GridPane.columnIndex="1" spacing="4" styleClass="report-card">
                    <Label text="Reservas canceladas" styleClass="kpi-label"/>
                    <Label fx:id="cancelledReservationsLabel" text="—" styleClass="kpi-value-danger"/>
                </VBox>

                <VBox GridPane.columnIndex="2" spacing="6" styleClass="report-card">
                    <Label text="Origen de mayor riesgo" styleClass="kpi-label"/>
                    <Label fx:id="highestRiskLabel" text="—" styleClass="kpi-value-danger"/>
                    <Label fx:id="highestRiskDetailLabel" text="" styleClass="kpi-detail"/>
                </VBox>
            </GridPane>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding><Insets top="6" right="18" bottom="18" left="18"/></padding>

            <VBox VBox.vgrow="ALWAYS" spacing="6" styleClass="report-card">
                <Label text="Probabilidad de cancelación por origen del cliente (%)"
                       styleClass="report-chart-title"/>
                <BarChart fx:id="originChart" VBox.vgrow="ALWAYS" styleClass="report-chart"
                          legendVisible="false" animated="false" barGap="4" categoryGap="20">
                    <xAxis><CategoryAxis fx:id="originAxis" label="Origen del cliente"/></xAxis>
                    <yAxis><NumberAxis fx:id="probabilityAxis" label="Probabilidad (%)"
                                       autoRanging="false" lowerBound="0" upperBound="100" tickUnit="10"/></yAxis>
                </BarChart>
            </VBox>

            <VBox prefHeight="240" spacing="6" styleClass="report-card">
                <Label text="Detalle por origen del cliente" styleClass="report-chart-title"/>
                <TableView fx:id="dataTable" VBox.vgrow="ALWAYS" styleClass="customer-table">
                    <columns>
                        <TableColumn fx:id="originColumn"             text="Origen"          prefWidth="150"/>
                        <TableColumn fx:id="totalColumn"              text="Reservas"        prefWidth="110"/>
                        <TableColumn fx:id="cancelledColumn"          text="Canceladas"      prefWidth="110"/>
                        <TableColumn fx:id="probabilityColumn"        text="Probabilidad"    prefWidth="130"/>
                        <TableColumn fx:id="visualColumn"             text="Distribución"    prefWidth="200"/>
                        <TableColumn fx:id="confidenceIntervalColumn" text="IC 95% (Wilson)" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="report-status-bar">
            <Label fx:id="statusLabel" text="Listo." styleClass="report-status-label"/>
        </HBox>
    </bottom>
</BorderPane>