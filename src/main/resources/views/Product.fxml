<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@/css/style.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ProductController">

    <VBox spacing="15"
          styleClass="content-main"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0"
          AnchorPane.topAnchor="0">

        <padding>
            <Insets bottom="20" left="20" right="20" top="20"/>
        </padding>

        <!-- Título y botones -->
        <HBox alignment="CENTER_LEFT" spacing="15">

            <Label styleClass="section-title" text="Productos">
                <font>
                    <Font size="24.0"/>
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnNewProduct"
                    styleClass="btn-primary"
                    text="Nuevo"/>

            <Button fx:id="btnViewInactive"
                    styleClass="btn-secondary"
                    text="📁 Eliminados"/>

        </HBox>

        <!-- Buscador -->
        <HBox alignment="CENTER_LEFT" spacing="15">

            <TextField fx:id="txtSearch"
                       promptText="🔍 Buscar por nombre o descripción..."
                       styleClass="search-field"
                       HBox.hgrow="ALWAYS"/>

        </HBox>

        <!-- Tabla + Detalle -->
        <SplitPane dividerPositions="0.75"
                   styleClass="split-pane"
                   VBox.vgrow="ALWAYS">

            <!-- Tabla -->
            <VBox spacing="10">

                <TableView fx:id="tableProducts"
                           styleClass="customer-table"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colName"
                                     prefWidth="180"
                                     text="Nombre"/>

                        <TableColumn fx:id="colDescription"
                                     prefWidth="300"
                                     text="Descripción"/>

                        <TableColumn fx:id="colPrice"
                                     prefWidth="120"
                                     text="Precio"/>

                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                </TableView>

                <Label fx:id="lblTotalProducts"
                       styleClass="footer-info"
                       text="Mostrando 0 productos"/>

            </VBox>

            <!-- Panel de detalle -->
            <VBox maxWidth="400.0"
                  minWidth="150.0"
                  prefWidth="400.0"
                  spacing="12"
                  styleClass="detail-panel">

                <padding>
                    <Insets bottom="15"
                            left="15"
                            right="15"
                            top="15"/>
                </padding>

                <!-- Nombre -->
                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      maxWidth="Infinity">

                    <TextField fx:id="txtDetailName"
                               text="Nombre del producto"
                               styleClass="detail-value-field-name"
                               editable="false"
                               focusTraversable="false"
                               HBox.hgrow="ALWAYS"/>

                </HBox>

                <!-- Descripción -->
                <Label text="Descripción:"
                       styleClass="detail-label"/>

                <TextField fx:id="txtDetailDescription"
                           text="--"
                           styleClass="detail-value-field"
                           editable="false"
                           focusTraversable="false"
                           maxWidth="Infinity"/>

                <!-- Precio -->
                <Label text="Precio:"
                       styleClass="detail-label"/>

                <TextField fx:id="txtDetailPrice"
                           text="--"
                           styleClass="detail-value-field"
                           editable="false"
                           focusTraversable="false"
                           maxWidth="Infinity"/>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Acciones -->
                <Button fx:id="btnEdit"
                        maxWidth="Infinity"
                        styleClass="btn-detail"
                        text="Editar"/>

                <Button fx:id="btnDeactivate"
                        maxWidth="Infinity"
                        styleClass="btn-detail-danger"
                        text="Eliminar"/>

            </VBox>

        </SplitPane>

    </VBox>

</AnchorPane>

