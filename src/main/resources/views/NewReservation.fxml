<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.ComboBox?>

<?import javafx.scene.control.DatePicker?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.control.ScrollPane?>

<?import javafx.scene.control.TableColumn?>

<?import javafx.scene.control.TableView?>

<?import javafx.scene.control.TextArea?>

<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.layout.ColumnConstraints?>

<?import javafx.scene.layout.GridPane?>

<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.Priority?>

<?import javafx.scene.layout.VBox?>

<ScrollPane
        fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        pannable="true"
        styleClass="new-reservation-scroll"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controllers.NewReservationController">

    <content>

        <VBox
                spacing="12.0"
                maxWidth="950.0"
                styleClass="new-reservation-container">

            <padding>
                <Insets
                        top="20.0"
                        right="30.0"
                        bottom="20.0"
                        left="30.0"/>
            </padding>


            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="12.0"
                    maxWidth="Infinity"
                    styleClass="reservation-page-header">

                <Button
                        text="←"
                        onAction="#handleVolver"
                        prefWidth="38.0"
                        prefHeight="38.0"
                        styleClass="reservation-back-button"/>

                <VBox
                        spacing="2.0"
                        HBox.hgrow="ALWAYS">

                    <Label
                            fx:id="lblReservationTitle"
                            text="Nueva Reserva"
                            styleClass="reservation-page-title"/>

                    <Label
                            text="Completa los datos para crear o modificar una reserva."
                            styleClass="reservation-page-subtitle"/>

                </VBox>

            </HBox>


            <!-- ================================================= -->
            <!-- DATOS DE LA RESERVA -->
            <!-- ================================================= -->

            <VBox
                    spacing="10.0"
                    maxWidth="Infinity"
                    styleClass="reservation-card">

                <Label
                        text="Datos de la reserva"
                        styleClass="reservation-card-title"/>

                <GridPane
                        hgap="14.0"
                        vgap="9.0"
                        maxWidth="Infinity"
                        styleClass="reservation-form-grid">

                    <columnConstraints>
                        <ColumnConstraints
                                minWidth="170.0"
                                prefWidth="170.0"/>

                        <ColumnConstraints
                                hgrow="ALWAYS"/>
                    </columnConstraints>


                    <!-- CLIENTE -->

                    <Label
                            text="Cliente:"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbCustomer"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Seleccione un cliente"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <!-- CHECK-IN -->

                    <Label
                            text="Check-in:"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <DatePicker
                            fx:id="dpCheckIn"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Seleccione la fecha"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <!-- CHECK-OUT -->

                    <Label
                            text="Check-out:"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <DatePicker
                            fx:id="dpCheckOut"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Seleccione la fecha"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <!-- HUÉSPEDES -->

                    <Label
                            text="Cantidad de huéspedes:"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <TextField
                            fx:id="txtNumberOfGuests"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Ej: 2"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <!-- TARIFA -->

                    <Label
                            text="Tarifa total:"
                            GridPane.rowIndex="4"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <TextField
                            fx:id="txtTotalRate"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Ej: 50000.00"
                            GridPane.rowIndex="4"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <!-- ESTADO -->

                    <Label
                            text="Estado:"
                            GridPane.rowIndex="5"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbReservationStatus"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Seleccione el estado"
                            GridPane.rowIndex="5"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <!-- TIPO -->

                    <Label
                            text="Tipo de reserva:"
                            GridPane.rowIndex="6"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbReservationType"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Seleccione el tipo"
                            GridPane.rowIndex="6"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>

                </GridPane>


                <!-- OBSERVACIONES -->

                <VBox
                        spacing="4.0"
                        maxWidth="Infinity">

                    <Label
                            text="Observaciones de la reserva:"
                            styleClass="reservation-field-label"/>

                    <TextArea
                            fx:id="txtReservationObservations"
                            prefRowCount="2"
                            prefHeight="55.0"
                            maxWidth="Infinity"
                            promptText="Ingrese observaciones..."
                            wrapText="true"
                            styleClass="reservation-textarea"/>

                </VBox>

            </VBox>


            <!-- ================================================= -->
            <!-- PAGO -->
            <!-- ================================================= -->

            <VBox
                    spacing="10.0"
                    maxWidth="Infinity"
                    styleClass="reservation-card">

                <VBox spacing="2.0">

                    <Label
                            text="Pago"
                            styleClass="reservation-card-title"/>

                    <Label
                            text="El registro del pago es opcional."
                            styleClass="reservation-card-description"/>

                </VBox>


                <GridPane
                        hgap="14.0"
                        vgap="9.0"
                        maxWidth="Infinity"
                        styleClass="reservation-form-grid">

                    <columnConstraints>
                        <ColumnConstraints
                                minWidth="170.0"
                                prefWidth="170.0"/>

                        <ColumnConstraints
                                hgrow="ALWAYS"/>
                    </columnConstraints>


                    <!-- IMPORTE -->

                    <Label
                            text="Importe:"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <TextField
                            fx:id="txtPaymentAmount"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Ej: 25000.00"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <!-- FECHA -->

                    <Label
                            text="Fecha de pago:"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <DatePicker
                            fx:id="dpPaymentDate"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Seleccione la fecha"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <!-- MÉTODO -->

                    <Label
                            text="Método de pago:"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbPaymentMethod"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Seleccione el método"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <!-- ESTADO -->

                    <Label
                            text="Estado del pago:"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbPaymentStatus"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Seleccione el estado"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>

                </GridPane>


                <!-- OBSERVACIONES PAGO -->

                <VBox
                        spacing="4.0"
                        maxWidth="Infinity">

                    <Label
                            text="Observaciones del pago:"
                            styleClass="reservation-field-label"/>

                    <TextArea
                            fx:id="txtPaymentObservations"
                            prefRowCount="2"
                            prefHeight="55.0"
                            maxWidth="Infinity"
                            promptText="Ingrese observaciones del pago..."
                            wrapText="true"
                            styleClass="reservation-textarea"/>

                </VBox>

            </VBox>


            <!-- ================================================= -->
            <!-- CONSUMOS -->
            <!-- ================================================= -->

            <VBox
                    spacing="10.0"
                    maxWidth="Infinity"
                    styleClass="reservation-card">

                <VBox spacing="2.0">

                    <Label
                            text="Consumos"
                            styleClass="reservation-card-title"/>

                    <Label
                            text="Agregue productos o servicios asociados a la reserva."
                            styleClass="reservation-card-description"/>

                </VBox>


                <!-- FORMULARIO DE CONSUMO -->

                <GridPane
                        hgap="14.0"
                        vgap="9.0"
                        maxWidth="Infinity"
                        styleClass="reservation-form-grid">

                    <columnConstraints>
                        <ColumnConstraints
                                minWidth="170.0"
                                prefWidth="170.0"/>

                        <ColumnConstraints
                                hgrow="ALWAYS"/>
                    </columnConstraints>


                    <!-- TIPO -->

                    <Label
                            text="Tipo de consumo:"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbConsumptionType"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Producto / Servicio"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <!-- PRODUCTO -->

                    <Label
                            text="Producto:"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbProduct"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Seleccione un producto"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <!-- SERVICIO -->

                    <Label
                            text="Servicio:"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbService"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Seleccione un servicio"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <!-- CANTIDAD -->

                    <Label
                            text="Cantidad:"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <TextField
                            fx:id="txtConsumptionQuantity"
                            prefHeight="34.0"
                            maxWidth="Infinity"
                            promptText="Ej: 2"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>

                </GridPane>


                <!-- BOTÓN AGREGAR -->

                <HBox
                        spacing="8.0"
                        alignment="CENTER_RIGHT"
                        maxWidth="Infinity">

                    <Button
                            text="+  Agregar consumo"
                            onAction="#handleAddConsumption"
                            prefWidth="170.0"
                            prefHeight="36.0"
                            styleClass="reservation-secondary-button"/>

                </HBox>


                <!-- ================================================= -->
                <!-- TABLA -->
                <!-- ================================================= -->

                <TableView
                        fx:id="tblConsumptions"
                        prefHeight="150.0"
                        minHeight="150.0"
                        maxHeight="150.0"
                        maxWidth="Infinity"
                        styleClass="reservation-table">

                    <columns>

                        <TableColumn
                                fx:id="colConsumptionType"
                                text="Tipo"
                                prefWidth="100.0"
                                minWidth="80.0"/>

                        <TableColumn
                                fx:id="colConsumptionName"
                                text="Nombre"
                                prefWidth="200.0"
                                minWidth="120.0"/>

                        <TableColumn
                                fx:id="colConsumptionQuantity"
                                text="Cantidad"
                                prefWidth="100.0"
                                minWidth="80.0"/>

                        <TableColumn
                                fx:id="colConsumptionUnitPrice"
                                text="Precio unitario"
                                prefWidth="140.0"
                                minWidth="110.0"/>

                        <TableColumn
                                fx:id="colConsumptionTotal"
                                text="Total"
                                prefWidth="130.0"
                                minWidth="100.0"/>

                    </columns>

                </TableView>


                <!-- ================================================= -->
                <!-- BOTONES DE CONSUMOS -->
                <!-- ================================================= -->

                <HBox
                        spacing="10.0"
                        alignment="CENTER_LEFT"
                        maxWidth="Infinity">

                    <Button
                            text="Modificar consumo"
                            onAction="#handleModifyConsumption"
                            prefWidth="170.0"
                            prefHeight="36.0"
                            styleClass="reservation-secondary-button"/>

                    <Button
                            text="Anular consumo"
                            onAction="#handleDeleteConsumption"
                            prefWidth="150.0"
                            prefHeight="36.0"
                            styleClass="reservation-danger-button"/>

                </HBox>


                <!-- ================================================= -->
                <!-- TOTAL CONSUMOS -->
                <!-- ================================================= -->

                <HBox
                        spacing="10.0"
                        alignment="CENTER_RIGHT"
                        maxWidth="Infinity"
                        styleClass="reservation-total-container">

                    <Label
                            text="Total consumos:"
                            styleClass="reservation-total-label"/>

                    <TextField
                            fx:id="txtConsumptionTotal"
                            text="0.00"
                            editable="false"
                            focusTraversable="false"
                            prefWidth="120.0"
                            prefHeight="34.0"
                            styleClass="reservation-total-field"/>

                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- BOTONES FINALES -->
            <!-- ================================================= -->

            <HBox
                    spacing="10.0"
                    alignment="CENTER_RIGHT"
                    maxWidth="Infinity"
                    styleClass="reservation-actions">

                <Button
                        text="Cancelar"
                        onAction="#handleCancel"
                        prefWidth="110.0"
                        prefHeight="38.0"
                        styleClass="reservation-cancel-button"/>

                <Button
                        text="Guardar reserva"
                        onAction="#handleSave"
                        prefWidth="170.0"
                        prefHeight="38.0"
                        styleClass="reservation-primary-button"/>

            </HBox>

        </VBox>

    </content>

</ScrollPane>


