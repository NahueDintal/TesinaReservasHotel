<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.ComboBox?>
        <?import javafx.scene.control.DatePicker?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.ScrollPane?>
        <?import javafx.scene.control.TableColumn?>
        <?import javafx.scene.control.TableView?>
        <?import javafx.scene.control.TextArea?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.ColumnConstraints?>
        <?import javafx.scene.layout.GridPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.VBox?>

<ScrollPane
        fitToWidth="true"
        minWidth="0.0"
        minHeight="0.0"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        pannable="true"
        styleClass="new-reservation-scroll"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controllers.NewReservationController">

    <content>

        <VBox
                spacing="18.0"
                styleClass="new-reservation-container">

            <padding>
                <Insets
                        top="22.0"
                        right="40.0"
                        bottom="25.0"
                        left="40.0"/>
            </padding>


            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="10.0"
                    maxWidth="Infinity"
                    styleClass="reservation-page-header">

                <Button
                        text="←"
                        onAction="#handleVolver"
                        prefWidth="40.0"
                        prefHeight="40.0"
                        styleClass="reservation-back-button"/>

                <VBox spacing="2.0">

                    <Label
                            text="Nueva Reserva"
                            styleClass="reservation-page-title"/>

                    <Label
                            text="Completa los datos para crear una nueva reserva."
                            styleClass="reservation-page-subtitle"/>

                </VBox>

            </HBox>


            <!-- ================================================= -->
            <!-- DATOS DE LA RESERVA -->
            <!-- ================================================= -->

            <VBox
                    spacing="14.0"
                    maxWidth="Infinity"
                    styleClass="reservation-card">

                <Label
                        text="Datos de la reserva"
                        styleClass="reservation-card-title"/>

                <GridPane
                        hgap="16.0"
                        vgap="10.0"
                        maxWidth="Infinity"
                        styleClass="reservation-form-grid">

                    <columnConstraints>
                        <ColumnConstraints minWidth="165.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label
                            text="Cliente:"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbCustomer"
                            prefWidth="220.0"
                            maxWidth="Infinity"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <Label
                            text="Check-in:"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <DatePicker
                            fx:id="dpCheckIn"
                            prefWidth="220.0"
                            maxWidth="Infinity"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <Label
                            text="Check-out:"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <DatePicker
                            fx:id="dpCheckOut"
                            prefWidth="220.0"
                            maxWidth="Infinity"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <Label
                            text="Cantidad de huéspedes:"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <TextField
                            fx:id="txtNumberOfGuests"
                            promptText="Ej: 2"
                            prefWidth="220.0"
                            maxWidth="Infinity"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <Label
                            text="Tarifa total:"
                            GridPane.rowIndex="4"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <TextField
                            fx:id="txtTotalRate"
                            promptText="Ej: 50000"
                            prefWidth="220.0"
                            maxWidth="Infinity"
                            GridPane.rowIndex="4"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <Label
                            text="Estado:"
                            GridPane.rowIndex="5"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbReservationStatus"
                            prefWidth="220.0"
                            maxWidth="Infinity"
                            GridPane.rowIndex="5"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <Label
                            text="Tipo de reserva:"
                            GridPane.rowIndex="6"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbReservationType"
                            prefWidth="220.0"
                            maxWidth="Infinity"
                            GridPane.rowIndex="6"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>

                </GridPane>


                <VBox spacing="5.0" maxWidth="Infinity">

                    <Label
                            text="Observaciones de la reserva:"
                            styleClass="reservation-field-label"/>

                    <TextArea
                            fx:id="txtReservationObservations"
                            prefRowCount="2"
                            promptText="Ingrese observaciones..."
                            wrapText="true"
                            maxWidth="Infinity"
                            styleClass="reservation-textarea"/>

                </VBox>

            </VBox>


            <!-- ================================================= -->
            <!-- PAGO -->
            <!-- ================================================= -->

            <VBox
                    spacing="14.0"
                    maxWidth="Infinity"
                    styleClass="reservation-card">

                <VBox spacing="2.0">

                    <Label
                            text="Pago"
                            styleClass="reservation-card-title"/>

                    <Label
                            text="El pago es opcional."
                            styleClass="reservation-card-description"/>

                </VBox>


                <GridPane
                        hgap="16.0"
                        vgap="10.0"
                        maxWidth="Infinity"
                        styleClass="reservation-form-grid">

                    <columnConstraints>
                        <ColumnConstraints minWidth="165.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label
                            text="Importe:"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <TextField
                            fx:id="txtPaymentAmount"
                            promptText="Ej: 25000"
                            prefWidth="220.0"
                            maxWidth="Infinity"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <Label
                            text="Fecha de pago:"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <DatePicker
                            fx:id="dpPaymentDate"
                            prefWidth="220.0"
                            maxWidth="Infinity"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <Label
                            text="Método de pago:"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbPaymentMethod"
                            prefWidth="220.0"
                            maxWidth="Infinity"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <Label
                            text="Estado del pago:"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbPaymentStatus"
                            prefWidth="220.0"
                            maxWidth="Infinity"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>

                </GridPane>


                <VBox spacing="5.0" maxWidth="Infinity">

                    <Label
                            text="Observaciones del pago:"
                            styleClass="reservation-field-label"/>

                    <TextArea
                            fx:id="txtPaymentObservations"
                            prefRowCount="2"
                            promptText="Ingrese observaciones del pago..."
                            wrapText="true"
                            maxWidth="Infinity"
                            styleClass="reservation-textarea"/>

                </VBox>

            </VBox>


            <!-- ================================================= -->
            <!-- CONSUMOS -->
            <!-- ================================================= -->

            <VBox
                    spacing="14.0"
                    maxWidth="Infinity"
                    styleClass="reservation-card">

                <Label
                        text="Consumos"
                        styleClass="reservation-card-title"/>


                <GridPane
                        hgap="16.0"
                        vgap="10.0"
                        maxWidth="Infinity"
                        styleClass="reservation-form-grid">

                    <columnConstraints>
                        <ColumnConstraints minWidth="165.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label
                            text="Tipo de consumo:"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbConsumptionType"
                            prefWidth="220.0"
                            maxWidth="Infinity"
                            promptText="1 - Producto / 2 - Servicio"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <Label
                            text="Producto:"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbProduct"
                            prefWidth="250.0"
                            maxWidth="Infinity"
                            promptText="Seleccione un producto"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <Label
                            text="Servicio:"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <ComboBox
                            fx:id="cmbService"
                            prefWidth="250.0"
                            maxWidth="Infinity"
                            promptText="Seleccione un servicio"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>


                    <Label
                            text="Cantidad:"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="0"
                            styleClass="reservation-field-label"/>

                    <TextField
                            fx:id="txtConsumptionQuantity"
                            prefWidth="220.0"
                            maxWidth="Infinity"
                            promptText="Ej: 2"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="1"
                            styleClass="reservation-field"/>

                </GridPane>


                <HBox
                        alignment="CENTER_RIGHT"
                        maxWidth="Infinity">

                    <Button
                            text="Agregar consumo"
                            onAction="#handleAddConsumption"
                            prefWidth="165.0"
                            prefHeight="36.0"
                            styleClass="reservation-secondary-button"/>

                </HBox>


                <!-- ================================================= -->
                <!-- TABLA -->
                <!-- ================================================= -->

                <TableView
                        fx:id="tblConsumptions"
                        prefHeight="190.0"
                        maxWidth="Infinity"
                        styleClass="reservation-table">

                    <columns>

                        <TableColumn
                                fx:id="colConsumptionType"
                                text="Tipo"
                                prefWidth="100.0"/>

                        <TableColumn
                                fx:id="colConsumptionName"
                                text="Nombre"
                                prefWidth="180.0"/>

                        <TableColumn
                                fx:id="colConsumptionQuantity"
                                text="Cantidad"
                                prefWidth="100.0"/>

                        <TableColumn
                                fx:id="colConsumptionUnitPrice"
                                text="Precio unitario"
                                prefWidth="130.0"/>

                        <TableColumn
                                fx:id="colConsumptionTotal"
                                text="Total"
                                prefWidth="130.0"/>

                    </columns>

                </TableView>


                <!-- ================================================= -->
                <!-- TOTAL -->
                <!-- ================================================= -->

                <HBox
                        spacing="12.0"
                        alignment="CENTER_RIGHT"
                        maxWidth="Infinity"
                        styleClass="reservation-total-container">

                    <Label
                            text="Total consumos:"
                            styleClass="reservation-total-label"/>

                    <TextField
                            fx:id="txtConsumptionTotal"
                            text="0.00"
                            editable="false"
                            prefWidth="120.0"
                            styleClass="reservation-total-field"/>

                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- ACCIONES -->
            <!-- ================================================= -->

            <HBox
                    spacing="10.0"
                    alignment="CENTER_RIGHT"
                    maxWidth="Infinity"
                    styleClass="reservation-actions">

                <Button
                        text="Cancelar"
                        onAction="#handleCancel"
                        prefWidth="110.0"
                        prefHeight="38.0"
                        styleClass="reservation-cancel-button"/>

                <Button
                        text="Guardar reserva"
                        onAction="#handleSave"
                        prefWidth="150.0"
                        prefHeight="38.0"
                        styleClass="reservation-primary-button"/>

            </HBox>

        </VBox>

    </content>

</ScrollPane>

