<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controllers.NewReservationController"
        prefWidth="900.0"
        prefHeight="700.0">

    <center>

        <ScrollPane
                fitToWidth="true"
                fitToHeight="false"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED">

            <content>

                <VBox
                        spacing="15.0"
                        fillWidth="true"
                        prefWidth="850.0"
                        maxWidth="850.0">

                    <padding>
                        <Insets top="30.0"
                                right="40.0"
                                bottom="30.0"
                                left="40.0"/>
                    </padding>

                    <!-- ========================= -->
                    <!-- TÍTULO -->
                    <!-- ========================= -->

                    <Label
                            text="Nueva Reserva"
                            style="-fx-font-size: 26px; -fx-font-weight: bold;"/>


                    <!-- ========================= -->
                    <!-- DATOS DE RESERVA -->
                    <!-- ========================= -->

                    <Label
                            text="Datos de la reserva"
                            style="-fx-font-size: 20px; -fx-font-weight: bold;"/>


                    <Label text="Cliente"/>

                    <ComboBox
                            fx:id="cmbCustomer"
                            prefWidth="350.0"
                            promptText="Seleccione un cliente"/>


                    <Label text="Check-in"/>

                    <DatePicker
                            fx:id="dpCheckIn"
                            prefWidth="350.0"/>


                    <Label text="Check-out"/>

                    <DatePicker
                            fx:id="dpCheckOut"
                            prefWidth="350.0"/>


                    <Label text="Cantidad de huéspedes"/>

                    <TextField
                            fx:id="txtNumberOfGuests"
                            prefWidth="350.0"
                            promptText="Ingrese cantidad de huéspedes"/>


                    <Label text="Tarifa total"/>

                    <TextField
                            fx:id="txtTotalRate"
                            prefWidth="350.0"
                            promptText="Ingrese tarifa total"/>


                    <Label text="Estado de reserva"/>

                    <ComboBox
                            fx:id="cmbReservationStatus"
                            prefWidth="350.0"
                            promptText="Seleccione un estado"/>


                    <Label text="Observaciones"/>

                    <TextArea
                            fx:id="txtReservationObservations"
                            prefWidth="500.0"
                            prefHeight="80.0"
                            wrapText="true"
                            promptText="Observaciones de la reserva"/>


                    <!-- ========================= -->
                    <!-- SECCIÓN PAGO -->
                    <!-- ========================= -->

                    <Label text="Datos del pago"/>

                    <fx:include
                            fx:id="payment"
                            source="payment.fxml"/>

                    <!-- ========================= -->
                    <!-- BOTONES -->
                    <!-- ========================= -->

                    <HBox
                            spacing="15.0"
                            alignment="CENTER_RIGHT">

                        <Button
                                text="Cancelar"
                                onAction="#handleCancel"
                                prefWidth="120.0"
                                prefHeight="40.0"/>

                        <Button
                                text="Guardar Reserva"
                                onAction="#handleSave"
                                prefWidth="160.0"
                                prefHeight="40.0"/>

                    </HBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>