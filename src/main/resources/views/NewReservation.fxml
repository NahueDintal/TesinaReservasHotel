<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>

<?import javafx.scene.control.Tooltip?>
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.NewReservationController"
           styleClass="new-reservation-root"
           maxWidth="Infinity"
           maxHeight="Infinity">

    <!-- CONTENIDO SCROLLEABLE -->
    <ScrollPane fx:id="reservationScroll"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                maxWidth="Infinity"
                maxHeight="Infinity"
                StackPane.alignment="TOP_LEFT"
                styleClass="new-reservation-scroll">

        <VBox maxWidth="Infinity"
              styleClass="new-reservation-content">

            <!-- ENCABEZADO -->
            <HBox alignment="CENTER_LEFT"
                  spacing="15"
                  maxWidth="Infinity"
                  styleClass="reservation-page-header">

                <Button text="←  Volver"
                        onAction="#handleBack"
                        styleClass="reservation-back-button"/>

                <VBox spacing="3"
                      HBox.hgrow="ALWAYS">

                    <Label fx:id="lblReservationTitle"
                           text="Nueva Reserva"
                           styleClass="reservation-page-title"/>

                    <Label text="Completá los datos de la reserva"
                           styleClass="reservation-page-subtitle"/>
                </VBox>
            </HBox>


            <!-- GRID PRINCIPAL -->
            <GridPane hgap="18"
                      vgap="18"
                      maxWidth="Infinity"
                      maxHeight="Infinity"
                      styleClass="reservation-dashboard-grid">

                <columnConstraints>
                    <ColumnConstraints percentWidth="65.0"
                                       hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="35.0"
                                       hgrow="ALWAYS"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints vgrow="NEVER"/>
                    <RowConstraints vgrow="ALWAYS"/>
                </rowConstraints>


                <!-- ================================================= -->
                <!-- DATOS DE LA RESERVA -->
                <!-- ================================================= -->

                <VBox GridPane.rowIndex="0"
                      GridPane.columnIndex="0"
                      spacing="14"
                      maxWidth="Infinity"
                      maxHeight="Infinity"
                      styleClass="card">

                    <Label text="Datos de la Reserva"
                           styleClass="card-title"/>

                    <Label text="Información principal de la estadía"
                           styleClass="card-description"/>


                    <!-- CLIENTE -->
                    <VBox spacing="5">
                        <Label text="Cliente"
                               styleClass="reservation-field-label"/>

                        <TextField fx:id="txtCustomerSearch"
                                   promptText="Buscar cliente..."
                                   maxWidth="Infinity"
                                   styleClass="reservation-field"/>

                        <ListView fx:id="lstCustomers"
                                  maxWidth="Infinity"
                                  prefHeight="90.0"
                                  maxHeight="90.0"
                                  styleClass="reservation-customer-list"/>
                    </VBox>


                    <!-- FECHAS -->
                    <HBox spacing="12"
                          maxWidth="Infinity">

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">
                            <Label text="Check-in"
                                   styleClass="reservation-field-label"/>

                            <DatePicker fx:id="dpCheckIn"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="reservation-field"/>
                        </VBox>

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">
                            <Label text="Check-out"
                                   styleClass="reservation-field-label"/>

                            <DatePicker fx:id="dpCheckOut"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="reservation-field"/>
                        </VBox>
                    </HBox>


                    <!-- HUÉSPEDES / TARIFA -->
                    <HBox spacing="12"
                          maxWidth="Infinity">

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">
                            <Label text="Cantidad de huéspedes"
                                   styleClass="reservation-field-label"/>

                            <TextField fx:id="txtNumberOfGuests"
                                       promptText="Cantidad"
                                       maxWidth="Infinity"
                                       styleClass="reservation-field"/>
                        </VBox>

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">
                            <Label text="Tarifa total"
                                   styleClass="reservation-field-label"/>

                            <TextField fx:id="txtTotalRate"
                                       promptText="0.00"
                                       maxWidth="Infinity"
                                       styleClass="reservation-field"/>
                        </VBox>
                    </HBox>


                    <!-- ESTADO / TIPO -->
                    <HBox spacing="12"
                          maxWidth="Infinity">

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">
                            <Label text="Estado"
                                   styleClass="reservation-field-label"/>

                            <ComboBox fx:id="cmbReservationStatus"
                                      maxWidth="Infinity"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="reservation-field"/>
                        </VBox>

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">
                            <Label text="Tipo de reserva"
                                   styleClass="reservation-field-label"/>

                            <ComboBox fx:id="cmbReservationType"
                                      maxWidth="Infinity"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="reservation-field"/>
                        </VBox>
                    </HBox>


                    <!-- HABITACIONES -->
                    <VBox spacing="5"
                          VBox.vgrow="ALWAYS">

                        <Label text="Habitaciones"
                               styleClass="reservation-field-label"/>

                        <Button fx:id="btnChangeRoom"
                                text="⚠️ Cambiar habitación"
                                onAction="#handleChangeRoom"
                                visible="false"
                                managed="false"
                                style="-fx-background-color: #2d6cdf;
                                -fx-text-fill: white;
                                -fx-font-weight: bold;
                                -fx-background-radius: 6;
                                -fx-padding: 6 14 6 14;
                                 -fx-font-family: 'Segoe UI Emoji', 'Segoe UI Symbol', 'Arial Unicode MS', sans-serif;"/>

                        <Button fx:id="btnHotelTourConstruction"
                                text="⚠ Hotel Tour (En Construcción)"
                                visible="false"
                                managed="false"
                                disable="true"
                                styleClass="btn-hotel-tour">
                            <tooltip>
                                <Tooltip text="Esta funcionalidad estará disponible en la próxima versión." />
                            </tooltip>
                        </Button>

                        <FlowPane fx:id="roomsContainer"
                                  hgap="8"
                                  vgap="8"
                                  maxWidth="Infinity"
                                  styleClass="rooms-container"/>
                    </VBox>


                    <!-- OBSERVACIONES -->
                    <VBox spacing="5">
                        <Label text="Observaciones"
                               styleClass="reservation-field-label"/>

                        <TextArea fx:id="txtReservationObservations"
                                  promptText="Observaciones de la reserva..."
                                  wrapText="true"
                                  maxWidth="Infinity"
                                  prefRowCount="3"
                                  styleClass="reservation-textarea"/>
                    </VBox>

                </VBox>


                <!-- ================================================= -->
                <!-- PAGO -->
                <!-- ================================================= -->

                <VBox GridPane.rowIndex="0"
                      GridPane.columnIndex="1"
                      spacing="14"
                      maxWidth="Infinity"
                      maxHeight="Infinity"
                      styleClass="card">

                    <Label text="Pago"
                           styleClass="card-title"/>

                    <Label text="Información del pago de la reserva"
                           styleClass="card-description"/>


                    <VBox spacing="5">
                        <Label text="Importe"
                               styleClass="reservation-field-label"/>

                        <TextField fx:id="txtPaymentAmount"
                                   promptText="0.00"
                                   maxWidth="Infinity"
                                   styleClass="reservation-field"/>
                    </VBox>


                    <VBox spacing="5">
                        <Label text="Fecha de pago"
                               styleClass="reservation-field-label"/>

                        <DatePicker fx:id="dpPaymentDate"
                                    maxWidth="Infinity"
                                    styleClass="reservation-field"/>
                    </VBox>


                    <VBox spacing="5">
                        <Label text="Método de pago"
                               styleClass="reservation-field-label"/>

                        <ComboBox fx:id="cmbPaymentMethod"
                                  maxWidth="Infinity"
                                  styleClass="reservation-field"/>
                    </VBox>


                    <VBox spacing="5">
                        <Label text="Estado del pago"
                               styleClass="reservation-field-label"/>

                        <ComboBox fx:id="cmbPaymentStatus"
                                  maxWidth="Infinity"
                                  styleClass="reservation-field"/>
                    </VBox>


                    <VBox spacing="5"
                          VBox.vgrow="ALWAYS">

                        <Label text="Observaciones"
                               styleClass="reservation-field-label"/>

                        <TextArea fx:id="txtPaymentObservations"
                                  promptText="Observaciones del pago..."
                                  wrapText="true"
                                  maxWidth="Infinity"
                                  VBox.vgrow="ALWAYS"
                                  styleClass="reservation-textarea"/>
                    </VBox>

                </VBox>


                <!-- ================================================= -->
                <!-- CONSUMOS -->
                <!-- ================================================= -->

                <VBox GridPane.rowIndex="1"
                      GridPane.columnIndex="0"
                      GridPane.columnSpan="2"
                      spacing="14"
                      maxWidth="Infinity"
                      VBox.vgrow="ALWAYS"
                      styleClass="card">

                    <Label text="Consumos"
                           styleClass="card-title"/>

                    <Label text="Productos y servicios asociados a la reserva"
                           styleClass="card-description"/>


                    <!-- FORMULARIO HORIZONTAL -->
                    <HBox spacing="12"
                          alignment="BOTTOM_LEFT"
                          maxWidth="Infinity"
                          styleClass="consumption-form">

                        <!-- TIPO -->
                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">

                            <Label text="Tipo"
                                   styleClass="reservation-field-label"/>

                            <ComboBox fx:id="cmbConsumptionType"
                                      maxWidth="Infinity"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="reservation-field"/>
                        </VBox>


                        <!-- PRODUCTO -->
                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">

                            <Label text="Producto"
                                   styleClass="reservation-field-label"/>

                            <ComboBox fx:id="cmbProduct"
                                      maxWidth="Infinity"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="reservation-field"/>
                        </VBox>


                        <!-- SERVICIO -->
                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">

                            <Label text="Servicio"
                                   styleClass="reservation-field-label"/>

                            <ComboBox fx:id="cmbService"
                                      maxWidth="Infinity"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="reservation-field"/>
                        </VBox>


                        <!-- CANTIDAD -->
                        <VBox spacing="5"
                              prefWidth="110.0">

                            <Label text="Cantidad"
                                   styleClass="reservation-field-label"/>

                            <TextField fx:id="txtConsumptionQuantity"
                                       promptText="Cantidad"
                                       maxWidth="Infinity"
                                       styleClass="reservation-field"/>
                        </VBox>


                        <!-- AGREGAR -->
                        <VBox spacing="5">

                            <Label text=" "
                                   styleClass="reservation-field-label"/>

                            <Button fx:id="btnConsumptionAction"
                                    text="Agregar"
                                    onAction="#handleAddConsumption"
                                    styleClass="reservation-secondary-button"/>
                        </VBox>

                    </HBox>


                    <!-- TABLA -->
                    <TableView fx:id="tblConsumptions"
                               maxWidth="Infinity"
                               minHeight="35.0"
                               prefHeight="100.0"
                               maxHeight="220.0"
                               styleClass="reservation-table">

                        <columns>

                            <TableColumn fx:id="colConsumptionType"
                                         text="Tipo"
                                         prefWidth="120.0"/>

                            <TableColumn fx:id="colConsumptionName"
                                         text="Producto / Servicio"
                                         prefWidth="250.0"/>

                            <TableColumn fx:id="colConsumptionQuantity"
                                         text="Cantidad"
                                         prefWidth="100.0"/>

                            <TableColumn fx:id="colConsumptionUnitPrice"
                                         text="Precio unitario"
                                         prefWidth="150.0"/>

                            <TableColumn fx:id="colConsumptionTotal"
                                         text="Total"
                                         prefWidth="150.0"/>

                            <TableColumn fx:id="colConsumptionActions"
                                         text="Acciones"
                                         prefWidth="120.0"/>

                        </columns>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>

                    </TableView>


                    <!-- TOTAL CONSUMOS -->
                    <HBox alignment="CENTER_RIGHT"
                          spacing="10"
                          maxWidth="Infinity"
                          styleClass="reservation-total-container">

                        <Label text="Total consumos:"
                               styleClass="reservation-total-label"/>

                        <TextField fx:id="txtConsumptionTotal"
                                   editable="false"
                                   focusTraversable="false"
                                   prefWidth="150.0"
                                   styleClass="reservation-total-field"/>
                    </HBox>

                </VBox>

            </GridPane>

        </VBox>
    </ScrollPane>


    <!-- ========================================================= -->
    <!-- FOOTER FIJO / STICKY -->
    <!-- ========================================================= -->

    <AnchorPane maxWidth="Infinity"
                maxHeight="80.0"
                prefHeight="70.0"
                mouseTransparent="false"
                pickOnBounds="false"
                StackPane.alignment="BOTTOM_CENTER"
                styleClass="reservation-floating-actions">

        <HBox AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              alignment="CENTER_RIGHT"
              spacing="12">

            <Button text="Cancelar"
                    onAction="#handleCancel"
                    styleClass="reservation-cancel-button"/>

            <Button fx:id="btnSaveReservation"
                    text="Guardar reserva"
                    onAction="#handleSave"
                    styleClass="reservation-primary-button"/>

        </HBox>

    </AnchorPane>

</StackPane>