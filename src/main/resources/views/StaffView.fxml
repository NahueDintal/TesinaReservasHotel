<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@/css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.StaffController">

    <VBox styleClass="content-main" spacing="15"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20" />
        </padding>

        <!-- Título y botones -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="Personal" styleClass="section-title">
                <font><Font size="24.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnNewStaff" text="+ Nuevo Personal" styleClass="btn-primary"
                    onAction="#handleNewStaff" />
            <Button fx:id="btnViewHistory" text="Historial" styleClass="btn-secondary"
                    onAction="#handleViewHistory" />
        </HBox>

        <!-- Buscador y filtro -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch" promptText="🔍 Buscar por nombre, DNI, cargo..."
                       styleClass="search-field" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="comboStatusFilter" promptText="Estado" prefWidth="120" />
        </HBox>

        <!-- SplitPane: Tabla + Detalle -->
        <SplitPane dividerPositions="0.7" VBox.vgrow="ALWAYS" styleClass="split-pane">
            <VBox spacing="10">
                <TableView fx:id="tableStaff" styleClass="staff-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                        <TableColumn fx:id="colFullName" text="Nombre Completo" prefWidth="150" />
                        <TableColumn fx:id="colDni" text="DNI" prefWidth="100" />
                        <TableColumn fx:id="colPosition" text="Cargo" prefWidth="120" />
                        <TableColumn fx:id="colDepartment" text="Área" prefWidth="120" />
                        <TableColumn fx:id="colPhone" text="Teléfono" prefWidth="100" />
                        <TableColumn fx:id="colStatus" text="Estado" prefWidth="100" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Panel de detalle -->
            <VBox spacing="12" styleClass="detail-panel" prefWidth="280.0" maxWidth="280.0">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15" />
                </padding>

                <Label text="Nombre:" styleClass="detail-label" />
                <Label fx:id="lblDetailName" text="--" styleClass="detail-value" />

                <Label text="Cargo:" styleClass="detail-label" />
                <Label fx:id="lblDetailPosition" text="--" styleClass="detail-value" />

                <Label text="Estado:" styleClass="detail-label" />
                <Label fx:id="lblDetailStatus" text="--" styleClass="detail-value" />

                <Label text="DNI:" styleClass="detail-label" />
                <Label fx:id="lblDetailDni" text="--" styleClass="detail-value" />

                <Label text="Fecha Nacimiento:" styleClass="detail-label" />
                <Label fx:id="lblDetailBirthDate" text="--" styleClass="detail-value" />

                <Label text="Teléfono:" styleClass="detail-label" />
                <Label fx:id="lblDetailPhone" text="--" styleClass="detail-value" />

                <Label text="Email:" styleClass="detail-label" />
                <Label fx:id="lblDetailEmail" text="--" styleClass="detail-value" />

                <Label text="Dirección:" styleClass="detail-label" />
                <Label fx:id="lblDetailAddress" text="--" styleClass="detail-value" wrapText="true" />

                <Label text="Área:" styleClass="detail-label" />
                <Label fx:id="lblDetailDepartment" text="--" styleClass="detail-value" />

                <Label text="Contratación:" styleClass="detail-label" />
                <Label fx:id="lblDetailHireDate" text="--" styleClass="detail-value" />

                <Label text="Turno:" styleClass="detail-label" />
                <Label fx:id="lblDetailShift" text="--" styleClass="detail-value" />

                <Label text="Salario:" styleClass="detail-label" />
                <Label fx:id="lblDetailSalary" text="--" styleClass="detail-value" />

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="btnEdit" text="Editar" styleClass="btn-detail" maxWidth="Infinity"
                        onAction="#handleEdit" />
                <Button fx:id="btnDeactivate" text="Inactivar" styleClass="btn-detail-danger"
                        maxWidth="Infinity" onAction="#handleDeactivate" />
            </VBox>
        </SplitPane>
    </VBox>
</AnchorPane>
