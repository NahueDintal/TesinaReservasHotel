<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="15" styleClass="form-container" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.InactiveCustomersController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- Title -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label styleClass="section-title" text="Eliminados">
            <font>
                <Font size="22.0" />
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnReactivate" disable="true" styleClass="btn-primary" text="Reactivar" />
    </HBox>

    <!-- Search Bar -->
    <TextField fx:id="txtSearch" promptText="🔍 Buscar por nombre, apellido, email, teléfono..." styleClass="search-field" />

    <!-- Table -->
    <TableView fx:id="tableInactiveCustomers" styleClass="customer-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFirstName" prefWidth="150" text="Nombres" />
            <TableColumn fx:id="colLastName" prefWidth="150" text="Apellidos" />
            <TableColumn fx:id="colDocumentType" prefWidth="150" text="Tipo Documento" />
            <TableColumn fx:id="colOrigin" prefWidth="150" text="Origen" />
            <TableColumn fx:id="colCountry" prefWidth="150" text="País" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Label fx:id="lblTotalInactive" styleClass="footer-info" text="Mostrando 0 clientes inactivos" />
</VBox>
