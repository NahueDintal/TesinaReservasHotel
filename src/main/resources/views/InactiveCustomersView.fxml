<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" styleClass="form-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.InactiveCustomersController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <!-- Title -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Clientes Inactivos" styleClass="section-title">
            <font>
                <Font size="22.0" />
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnReactivate" text="♻️ Reactivar" styleClass="btn-primary" disable="true" />
        <Button fx:id="btnClose" text="Cerrar" styleClass="btn-secondary" />
    </HBox>

    <!-- Search Bar -->
    <TextField fx:id="txtSearch" promptText="🔍 Buscar por nombre, apellido, email, teléfono..." styleClass="search-field" />

    <!-- Table -->
    <TableView fx:id="tableInactiveCustomers" styleClass="customer-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFirstName" text="Nombres" prefWidth="150" />
            <TableColumn fx:id="colLastName" text="Apellidos" prefWidth="150" />
            <TableColumn fx:id="colDocumentType" text="Tipo Documento" prefWidth="150" />
            <TableColumn fx:id="colOrigin" text="Origen" prefWidth="150" />
            <TableColumn fx:id="colCountry" text="País" prefWidth="150" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Label fx:id="lblTotalInactive" text="Mostrando 0 clientes inactivos" styleClass="footer-info" />
</VBox>