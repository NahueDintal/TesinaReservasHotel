<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@/css/style.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.RoomController">

    <VBox styleClass="content-main" spacing="15"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20" />
        </padding>

        <!-- Título y botones -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="Habitaciones" styleClass="section-title">
                <font><Font size="24.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnNewRoom" text="+ Nueva Habitación" styleClass="btn-primary" />
            <Button fx:id="btnViewUnavailable" text="📁 Ver no disponibles" styleClass="btn-secondary" />
        </HBox>

        <!-- Buscador -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch" promptText="🔍 Buscar por número, tipo, vista, precio..." styleClass="search-field" HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- SplitPane: Tabla + Detalle -->
        <SplitPane dividerPositions="0.7" VBox.vgrow="ALWAYS" styleClass="split-pane">
            <VBox spacing="10">
                <TableView fx:id="tableRooms" styleClass="room-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNumber" text="Número" prefWidth="80" />
                        <TableColumn fx:id="colFloor" text="Piso" prefWidth="60" />
                        <TableColumn fx:id="colType" text="Tipo" prefWidth="100" />
                        <TableColumn fx:id="colCapacity" text="Capacidad" prefWidth="80" />
                        <TableColumn fx:id="colView" text="Vista" prefWidth="120" />
                        <TableColumn fx:id="colPrice" text="Precio" prefWidth="90" />
                        <TableColumn fx:id="colAvailable" text="Disponible" prefWidth="100" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <Label fx:id="lblTotalRooms" text="Mostrando 0 habitaciones" styleClass="footer-info" />
            </VBox>

            <!-- Panel de detalle -->
            <VBox spacing="12" styleClass="detail-panel" prefWidth="280.0" maxWidth="280.0">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="lblDetailNumber" text="--" styleClass="detail-name" wrapText="true" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblDetailStatus" text="" styleClass="detail-status" />
                </HBox>

                <Label text="Piso:" styleClass="detail-label" />
                <Label fx:id="lblDetailFloor" text="--" styleClass="detail-value" />

                <Label text="Tipo:" styleClass="detail-label" />
                <Label fx:id="lblDetailType" text="--" styleClass="detail-value" />

                <Label text="Capacidad:" styleClass="detail-label" />
                <Label fx:id="lblDetailCapacity" text="--" styleClass="detail-value" />

                <Label text="Vista:" styleClass="detail-label" />
                <Label fx:id="lblDetailView" text="--" styleClass="detail-value" />

                <Label text="Precio:" styleClass="detail-label" />
                <Label fx:id="lblDetailPrice" text="--" styleClass="detail-value" />

                <Label text="Características:" styleClass="detail-label" />
                <Label fx:id="lblDetailFeatures" text="--" styleClass="detail-value" wrapText="true" />

                <Label text="Descripción:" styleClass="detail-label" />
                <Label fx:id="lblDetailDescription" text="--" styleClass="detail-value" wrapText="true" />

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="btnEdit" text="Editar" styleClass="btn-detail" maxWidth="Infinity" />
                <Button fx:id="btnDeactivate" text="Marcar no disponible" styleClass="btn-detail-danger" maxWidth="Infinity" />
            </VBox>
        </SplitPane>
    </VBox>
</AnchorPane>
