<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.RoomController">

  <VBox spacing="15" styleClass="room-table" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
    <padding>
      <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
      <Label styleClass="room-table" text="Habitaciones">
        <font><Font name="System Bold" size="24.0" /></font>
      </Label>
      <Region HBox.hgrow="ALWAYS" />
      <Button fx:id="btnNewRoom" styleClass="btn-primary" text="Nuevo" />
      <Button fx:id="btnViewUnavailable" styleClass="btn-secondary" text="Fuera de servicio" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <TextField fx:id="txtSearch" promptText="🔍 Buscar por número, tipo, vista, precio..." styleClass="search-field" HBox.hgrow="ALWAYS" />
    </HBox>

    <SplitPane dividerPositions="0.75" styleClass="SplitPane" VBox.vgrow="ALWAYS">
      <VBox spacing="10">
        <TableView fx:id="tableRooms" styleClass="customer-table" VBox.vgrow="ALWAYS">
          <columns>
            <TableColumn fx:id="colNumber" prefWidth="80" sortType="DESCENDING" text="Número" />
            <TableColumn fx:id="colFloor" prefWidth="60" text="Piso" />
            <TableColumn fx:id="colType" prefWidth="100" text="Tipo" />
            <TableColumn fx:id="colCapacity" prefWidth="80" text="Capacidad" />
            <TableColumn fx:id="colView" prefWidth="120" text="Vista" />
            <TableColumn fx:id="colPrice" prefWidth="90" text="Precio" />
            <TableColumn fx:id="colAvailable" prefWidth="100" text="Disponible" />
          </columns>
          <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
          </columnResizePolicy>
        </TableView>
        <Label fx:id="lblTotalRooms" styleClass="footer-info" text="Mostrando 0 habitaciones" />
      </VBox>

      <VBox maxWidth="400.0" minWidth="150.0" prefWidth="400.0" spacing="12" styleClass="detail-panel">
        <padding>
          <Insets bottom="15" left="15" right="15" top="15" />
        </padding>

        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10">
          <TextField fx:id="lblDetailNumber" editable="false" focusTraversable="false" styleClass="detail-value-field-name" text="--" HBox.hgrow="ALWAYS" />
          <Label fx:id="lblDetailStatus" styleClass="detail-status" text="" />
        </HBox>

        <Label styleClass="detail-label" text="Piso:" />
        <TextField fx:id="lblDetailFloor" editable="false" focusTraversable="false" maxWidth="Infinity" styleClass="detail-value-field" text="--" />

        <Label styleClass="detail-label" text="Tipo:" />
        <TextField fx:id="lblDetailType" editable="false" focusTraversable="false" maxWidth="Infinity" styleClass="detail-value-field" text="--" />

        <Label styleClass="detail-label" text="Capacidad:" />
        <TextField fx:id="lblDetailCapacity" editable="false" focusTraversable="false" maxWidth="Infinity" styleClass="detail-value-field" text="--" />

        <Label styleClass="detail-label" text="Vista:" />
        <TextField fx:id="lblDetailView" editable="false" focusTraversable="false" maxWidth="Infinity" styleClass="detail-value-field" text="--" />

        <Label styleClass="detail-label" text="Precio:" />
        <TextField fx:id="lblDetailPrice" editable="false" focusTraversable="false" maxWidth="Infinity" styleClass="detail-value-field" text="--" />

        <Label styleClass="detail-label" text="Características:" />
        <TextField fx:id="lblDetailFeatures" editable="false" focusTraversable="false" maxWidth="Infinity" styleClass="detail-value-field" text="--" />

        <Label styleClass="detail-label" text="Descripción:" />
        <TextField fx:id="lblDetailDescription" editable="false" focusTraversable="false" maxWidth="Infinity" styleClass="detail-value-field" text="--" />

        <Region VBox.vgrow="ALWAYS" />

        <Button fx:id="btnEdit" maxWidth="Infinity" styleClass="btn-detail" text="Editar" />
        <Button fx:id="btnDeactivate" maxWidth="Infinity" styleClass="btn-detail-danger" text="Marcar como fuera de servicio" />
        <Button fx:id="btnDelete" maxWidth="Infinity" styleClass="btn-detail-danger" text="Eliminar" />
      </VBox>
    </SplitPane>
  </VBox>
</AnchorPane>
