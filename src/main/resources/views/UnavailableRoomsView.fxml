<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" styleClass="form-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UnavailableRoomsController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Habitaciones No Disponibles" styleClass="section-title">
            <font><Font size="22.0" /></font>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnReactivate" text="Reactivar" styleClass="btn-primary" disable="true" />
    </HBox>

    <TextField fx:id="txtSearch" promptText="🔍 Buscar por número, tipo, vista..." styleClass="search-field" />

    <TableView fx:id="tableUnavailableRooms" styleClass="room-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumber" text="Número" prefWidth="100" />
            <TableColumn fx:id="colFloor" text="Piso" prefWidth="80" />
            <TableColumn fx:id="colType" text="Tipo" prefWidth="120" />
            <TableColumn fx:id="colCapacity" text="Capacidad" prefWidth="100" />
            <TableColumn fx:id="colPrice" text="Precio" prefWidth="120" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Label fx:id="lblTotalUnavailable" text="Mostrando 0 habitaciones no disponibles" styleClass="footer-info" />
</VBox>
