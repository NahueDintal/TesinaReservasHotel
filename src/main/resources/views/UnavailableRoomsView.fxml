<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox Spacing="15" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UnavailableRoomsController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label styleClass="section-title" text="Habitaciones fuera de servicio">
            <font><Font size="22.0" /></font>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnReactivate" disable="true" styleClass="btn-primary" text="Reactivar" />
    </HBox>

    <TextField fx:id="txtSearch" promptText="🔍 Buscar por número, tipo, vista..." styleClass="search-field" />

    <TableView fx:id="tableUnavailableRooms" styleClass="customer-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumber" prefWidth="100" text="Número" />
            <TableColumn fx:id="colFloor" prefWidth="80" text="Piso" />
            <TableColumn fx:id="colType" prefWidth="120" text="Tipo" />
            <TableColumn fx:id="colCapacity" prefWidth="100" text="Capacidad" />
            <TableColumn fx:id="colPrice" prefWidth="120" text="Precio" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Label fx:id="lblTotalUnavailable" styleClass="footer-info" text="Mostrando 0 habitaciones no disponibles" />
</VBox>
