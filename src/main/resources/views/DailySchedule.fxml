<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DailyScheduleController"
            styleClass="content-main">

    <top>
        <VBox spacing="12">
            <padding><Insets top="18" right="18" bottom="12" left="18"/></padding>

            <!-- Títulos con clases -->
            <Label text="Cronograma de check-in y check-out" styleClass="section-title"/>
            <Label text="Movimientos programados para una fecha específica. Útil para el trabajo diario de recepción." styleClass="subtitulo-seccion"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Fecha:" styleClass="form-label"/>
                <DatePicker fx:id="datePicker" prefWidth="160" styleClass="date-picker"/>
                <Button fx:id="todayButton" text="Hoy" onAction="#onToday" styleClass="btn-secondary"/>
                <Button fx:id="calculateButton" text="Mostrar" onAction="#onCalculate" defaultButton="true" styleClass="btn-primary"/>
                <Button fx:id="exportButton" text="Exportar CSV" onAction="#onExport" styleClass="btn-secondary"/>
            </HBox>

            <GridPane hgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <!-- Tarjetas KPI -->
                <VBox GridPane.columnIndex="0" spacing="4" styleClass="report-card">
                    <Label text="Check-ins del día" styleClass="kpi-label"/>
                    <Label fx:id="checkInCountLabel" text="—" styleClass="kpi-value-accent"/>
                </VBox>

                <VBox GridPane.columnIndex="1" spacing="4" styleClass="report-card">
                    <Label text="Check-outs del día" styleClass="kpi-label"/>
                    <Label fx:id="checkOutCountLabel" text="—" styleClass="kpi-value-danger"/>
                </VBox>

                <VBox GridPane.columnIndex="2" spacing="4" styleClass="report-card">
                    <Label text="Huéspedes que llegan" styleClass="kpi-label"/>
                    <Label fx:id="guestsArrivingLabel" text="—" styleClass="kpi-value"/>
                </VBox>

                <VBox GridPane.columnIndex="3" spacing="4" styleClass="report-card">
                    <Label text="Huéspedes que se van" styleClass="kpi-label"/>
                    <Label fx:id="guestsDepartingLabel" text="—" styleClass="kpi-value"/>
                </VBox>
            </GridPane>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.5" styleClass="split-pane">
            <padding><Insets top="6" right="18" bottom="18" left="18"/></padding>

            <!-- Check-ins -->
            <VBox spacing="6" styleClass="report-card">
                <!-- 🔥 Acá cambié a las clases de tus reportes -->
                <Label text="Check-ins programados" styleClass="report-chart-title text-success"/>
                <TableView fx:id="checkInTable" VBox.vgrow="ALWAYS" styleClass="customer-table">
                    <columns>
                        <TableColumn fx:id="ciIdColumn"        text="Reserva"     prefWidth="80"/>
                        <TableColumn fx:id="ciCustomerColumn"  text="Huésped"     prefWidth="200"/>
                        <TableColumn fx:id="ciGuestsColumn"    text="Huéspedes"   prefWidth="90"/>
                        <TableColumn fx:id="ciRateColumn"      text="Tarifa"      prefWidth="100"/>
                        <TableColumn fx:id="ciStatusColumn"    text="Estado"      prefWidth="100"/>
                        <TableColumn fx:id="ciObsColumn"       text="Observaciones" prefWidth="200"/>
                    </columns>
                </TableView>
                <Label fx:id="checkInFooterLabel" text="0 check-ins" styleClass="footer-info"/>
            </VBox>

            <!-- Check-outs -->
            <VBox spacing="6" styleClass="report-card">
                <!-- 🔥 Acá también -->
                <Label text="Check-outs programados" styleClass="report-chart-title text-danger"/>
                <TableView fx:id="checkOutTable" VBox.vgrow="ALWAYS" styleClass="customer-table">
                    <columns>
                        <TableColumn fx:id="coIdColumn"        text="Reserva"     prefWidth="80"/>
                        <TableColumn fx:id="coCustomerColumn"  text="Huésped"     prefWidth="200"/>
                        <TableColumn fx:id="coGuestsColumn"    text="Huéspedes"   prefWidth="90"/>
                        <TableColumn fx:id="coRateColumn"      text="Tarifa"      prefWidth="100"/>
                        <TableColumn fx:id="coStatusColumn"    text="Estado"      prefWidth="100"/>
                        <TableColumn fx:id="coObsColumn"       text="Observaciones" prefWidth="200"/>
                    </columns>
                </TableView>
                <Label fx:id="checkOutFooterLabel" text="0 check-outs" styleClass="footer-info"/>
            </VBox>
        </SplitPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="report-status-bar">
            <Label fx:id="statusLabel" text="Listo." styleClass="report-status-label"/>
        </HBox>
    </bottom>
</BorderPane>
