<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0"
            prefWidth="750.0"
            styleClass="content-main"
            stylesheets="@/css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.InactiveServicesController">

    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="20"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Label text="Servicios Eliminados"
                   styleClass="section-title">

                <font>
                    <Font size="24.0"/>
                </font>

            </Label>

            <Label text="Servicios desactivados que pueden volver a utilizarse."
                   styleClass="footer-info"/>

        </VBox>
    </top>

    <center>

        <VBox spacing="10">

            <padding>
                <Insets top="0"
                        right="20"
                        bottom="10"
                        left="20"/>
            </padding>

            <TableView fx:id="tableInactiveServices"
                       styleClass="customer-table"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colName"
                                 text="Nombre"
                                 prefWidth="180"/>

                    <TableColumn fx:id="colDescription"
                                 text="Descripción"
                                 prefWidth="300"/>

                    <TableColumn fx:id="colPrice"
                                 text="Precio"
                                 prefWidth="120"/>

                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

            </TableView>

            <Label fx:id="lblTotalServices"
                   text="Mostrando 0 servicios"
                   styleClass="footer-info"/>

        </VBox>

    </center>

    <bottom>

        <HBox alignment="CENTER_RIGHT"
              spacing="12">

            <padding>
                <Insets top="10"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Button fx:id="btnActivate"
                    text="Reactivar"
                    styleClass="btn-primary"
                    disable="true"/>

            <Button fx:id="btnClose"
                    text="Cerrar"
                    styleClass="btn-secondary"/>

        </HBox>

    </bottom>

</BorderPane>

