<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="200.0" prefWidth="200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PaymentController">
   <children>
      <VBox alignment="CENTER" layoutX="24.0" prefHeight="400.0" prefWidth="483.0" spacing="1.0">
         <children>
            <Label text="Gestión de Pago" textAlignment="CENTER">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Label text="Reserva" />
            <TextField fx:id="txtIDReservation" promptText="ID de Reserva" />
            <Label text="Importe" />
            <TextField fx:id="txtAmount" promptText="Ingrese el importe" />
            <Label text="Fecha de pago" />
            <DatePicker fx:id="dpPaymentDate" />
            <Label text="Metodo de Pago" />
            <ComboBox fx:id="cmbPaymentMethod" prefWidth="150.0" />
            <Label text="Estado de pago" />
            <ComboBox fx:id="cmbPaymentStatus" prefWidth="150.0" />
            <Label text="Observaciones" />
            <TextArea fx:id="txtObservations" prefHeight="45.0" prefWidth="483.0" />
            <HBox prefHeight="0.0" prefWidth="483.0" />
            <Button fx:id="btnCancel" mnemonicParsing="false" onAction="#handleCancel" text="Cancelar" />
            <Button fx:id="btnSave" mnemonicParsing="false" onAction="#handleSave" text="Guardar Pago" />
         </children>
      </VBox>
   </children>
</AnchorPane>
