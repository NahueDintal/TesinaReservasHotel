<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.control.TableColumn?>

<?import javafx.scene.control.TableView?>

<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.VBox?>

<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0"
            prefWidth="670.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ReservationsController">

    <children>

        <VBox spacing="15.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <padding>
                <Insets top="25.0"
                        right="25.0"
                        bottom="25.0"
                        left="25.0"/>
            </padding>

            <!-- ENCABEZADO -->
            <HBox alignment="CENTER_LEFT"
                  spacing="10.0">

                <Label text="Reservas">
                    <font>
                        <Font name="Adwaita Sans Bold"
                              size="24.0"/>
                    </font>
                </Label>

                <HBox HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnNuevaReserva"
                        text="Nueva reserva"
                        onAction="#handleNuevaReserva"
                        prefHeight="38.0"
                        prefWidth="140.0"
                        style="-fx-background-color: #3E864D;
                           -fx-text-fill: white;
                           -fx-background-radius: 6;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"/>
            </HBox>

            <!-- TABLA -->
            <TableView fx:id="tblReservations"
                       VBox.vgrow="ALWAYS"
                       prefHeight="500.0">

                <columns>

                    <TableColumn fx:id="colIdReservation"
                                 text="N°"
                                 prefWidth="55.0"/>

                    <TableColumn fx:id="colCustomer"
                                 text="Cliente"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="colCheckIn"
                                 text="Check-in"
                                 prefWidth="100.0"/>

                    <TableColumn fx:id="colCheckOut"
                                 text="Check-out"
                                 prefWidth="100.0"/>

                    <TableColumn fx:id="colGuests"
                                 text="Huéspedes"
                                 prefWidth="80.0"/>

                    <TableColumn fx:id="colTotalRate"
                                 text="Tarifa total"
                                 prefWidth="100.0"/>

                    <TableColumn fx:id="colStatus"
                                 text="Estado"
                                 prefWidth="100.0"/>

                </columns>

            </TableView>

        </VBox>

    </children>

</AnchorPane>


