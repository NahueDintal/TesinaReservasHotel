<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.TableColumn?>
        <?import javafx.scene.control.TableView?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.AnchorPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.VBox?>

<AnchorPane
        minWidth="0.0"
        minHeight="0.0"
        styleClass="reservations-page"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controllers.ReservationsController">

    <children>

        <VBox
                spacing="18.0"
                AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                styleClass="reservations-container">

            <padding>
                <Insets
                        top="28.0"
                        right="30.0"
                        bottom="25.0"
                        left="30.0"/>
            </padding>


            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="10.0"
                    styleClass="reservations-header">

                <VBox spacing="4.0">

                    <Label
                            text="Reservas"
                            styleClass="reservations-title"/>

                    <Label
                            text="Consulta y gestiona todas las reservas del hotel."
                            styleClass="reservations-subtitle"/>

                </VBox>


                <HBox HBox.hgrow="ALWAYS"/>


                <Button
                        fx:id="btnNuevaReserva"
                        text="＋  Nueva reserva"
                        onAction="#handleNuevaReserva"
                        prefHeight="42.0"
                        prefWidth="155.0"
                        styleClass="btn-new-reservation"/>

            </HBox>


            <!-- ================================================= -->
            <!-- BUSCADOR -->
            <!-- ================================================= -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="12.0"
                    styleClass="search-container">

                <TextField
                        fx:id="txtBuscarReserva"
                        promptText="Buscar por número, cliente o estado..."
                        prefHeight="42.0"
                        HBox.hgrow="ALWAYS"
                        styleClass="reservation-search"/>

            </HBox>


            <!-- ================================================= -->
            <!-- TABLA -->
            <!-- ================================================= -->

            <VBox
                    VBox.vgrow="ALWAYS"
                    styleClass="table-container">

                <TableView
                        fx:id="tblReservations"
                        VBox.vgrow="ALWAYS"
                        styleClass="reservations-table">

                    <columns>

                        <TableColumn
                                fx:id="colIdReservation"
                                text="N°"
                                prefWidth="65.0"/>

                        <TableColumn
                                fx:id="colCustomer"
                                text="Cliente"
                                prefWidth="190.0"/>

                        <TableColumn
                                fx:id="colCheckIn"
                                text="Check-in"
                                prefWidth="110.0"/>

                        <TableColumn
                                fx:id="colCheckOut"
                                text="Check-out"
                                prefWidth="110.0"/>

                        <TableColumn
                                fx:id="colGuests"
                                text="Huéspedes"
                                prefWidth="100.0"/>

                        <TableColumn
                                fx:id="colTotalRate"
                                text="Tarifa total"
                                prefWidth="120.0"/>

                        <TableColumn
                                fx:id="colStatus"
                                text="Estado"
                                prefWidth="130.0"/>

                        <TableColumn
                                fx:id="colActions"
                                text="Acciones"
                                prefWidth="190.0"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </children>

</AnchorPane>

