<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controllers.ReservationsController"
        stylesheets="@/css/style.css">

    <VBox
            spacing="15"
            styleClass="content-main"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0"
            AnchorPane.topAnchor="0">

        <padding>
            <Insets
                    top="20"
                    right="20"
                    bottom="20"
                    left="20"/>
        </padding>

        <!-- TÍTULO Y NUEVA RESERVA -->
        <HBox
                alignment="CENTER_LEFT"
                spacing="15">

            <VBox spacing="3">

                <Label
                        text="Reservas"
                        styleClass="section-title"/>

                <Label
                        text="Gestión de reservas del hotel"
                        styleClass="section-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button
                    fx:id="btnNuevaReserva"
                    text="Nueva reserva"
                    styleClass="btn-primary"
                    onAction="#handleNewReservation"/>
        </HBox>


        <!-- BUSCADOR Y FILTRO -->
        <HBox
                alignment="CENTER_LEFT"
                spacing="15">

            <TextField
                    fx:id="txtBuscarReserva"
                    promptText="🔍 Buscar por cliente..."
                    styleClass="search-field"
                    HBox.hgrow="ALWAYS"/>

            <ComboBox
                    fx:id="cmbEstadoReserva"
                    prefWidth="180"
                    promptText="Estado"/>

        </HBox>


        <!-- TABLA + DETALLE -->
        <SplitPane
                dividerPositions="0.72"
                styleClass="split-pane"
                VBox.vgrow="ALWAYS">

            <!-- TABLA -->
            <VBox
                    minWidth="450.0"
                    prefWidth="700.0"
                    maxWidth="900.0"
                    spacing="10">

                <TableView
                        fx:id="tblReservations"
                        styleClass="customer-table"
                        VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn
                                fx:id="colIdReservation"
                                prefWidth="70"
                                text="N°"/>

                        <TableColumn
                                fx:id="colCustomer"
                                prefWidth="160"
                                text="Cliente"/>

                        <TableColumn
                                fx:id="colCheckIn"
                                prefWidth="110"
                                text="Check-in"/>

                        <TableColumn
                                fx:id="colCheckOut"
                                prefWidth="110"
                                text="Check-out"/>

                        <TableColumn
                                fx:id="colGuests"
                                prefWidth="80"
                                text="Huéspedes"/>

                        <TableColumn fx:id="colRooms" prefWidth="110" text="Habitación" />
                        <TableColumn
                                fx:id="colTotalRate"
                                prefWidth="110"
                                text="Tarifa"/>

                        <TableColumn
                                fx:id="colStatus"
                                prefWidth="110"
                                text="Estado"/>

                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                </TableView>

                <Label
                        fx:id="lblTotalReservations"
                        styleClass="footer-info"
                        text="Mostrando 0 reservas"/>

            </VBox>


            <!-- PANEL DE DETALLE -->
            <ScrollPane
                    minWidth="220.0"
                    prefWidth="300.0"
                    maxWidth="380.0"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="detail-scroll"
                    VBox.vgrow="ALWAYS">

                <content>

                    <VBox
                            maxWidth="350.0"
                            minWidth="220.0"
                            prefWidth="300.0"
                            spacing="12"
                            styleClass="detail-panel">

                        <padding>
                            <Insets
                                    top="15"
                                    right="15"
                                    bottom="15"
                                    left="15"/>
                        </padding>

                        <Label
                                fx:id="lblDetailTitle"
                                text="Seleccione una reserva"
                                styleClass="detail-title"/>

                        <Label
                                text="Número de reserva:"
                                styleClass="detail-label"/>

                        <TextField
                                fx:id="txtDetailReservationNumber"
                                text="--"
                                styleClass="detail-value-field"
                                editable="false"
                                focusTraversable="false"/>

                        <Label
                                text="Cliente:"
                                styleClass="detail-label"/>

                        <TextField
                                fx:id="txtDetailCustomer"
                                text="--"
                                styleClass="detail-value-field"
                                editable="false"
                                focusTraversable="false"
                                maxWidth="Infinity"/>

                        <Label
                                text="Check-in:"
                                styleClass="detail-label"/>

                        <TextField
                                fx:id="txtDetailCheckIn"
                                text="--"
                                styleClass="detail-value-field"
                                editable="false"
                                focusTraversable="false"
                                maxWidth="Infinity"/>

                        <Label
                                text="Check-out:"
                                styleClass="detail-label"/>

                        <TextField
                                fx:id="txtDetailCheckOut"
                                text="--"
                                styleClass="detail-value-field"
                                editable="false"
                                focusTraversable="false"
                                maxWidth="Infinity"/>

                        <Label
                                text="Huéspedes:"
                                styleClass="detail-label"/>

                        <TextField
                                fx:id="txtDetailGuests"
                                text="--"
                                styleClass="detail-value-field"
                                editable="false"
                                focusTraversable="false"
                                maxWidth="Infinity"/>

                        <Label
                                text="Tarifa total:"
                                styleClass="detail-label"/>

                        <TextField
                                fx:id="txtDetailTotalRate"
                                text="--"
                                styleClass="detail-value-field"
                                editable="false"
                                focusTraversable="false"
                                maxWidth="Infinity"/>

                        <Label
                                text="Estado:"
                                styleClass="detail-label"/>

                        <TextField
                                fx:id="txtDetailStatus"
                                text="--"
                                styleClass="detail-value-field"
                                editable="false"
                                focusTraversable="false"
                                maxWidth="Infinity"/>

                        <Label
                                text="Tipo de reserva:"
                                styleClass="detail-label"/>

                        <TextField
                                fx:id="txtDetailType"
                                text="--"
                                styleClass="detail-value-field"
                                editable="false"
                                focusTraversable="false"
                                maxWidth="Infinity"/>

                        <Button
                                fx:id="btnViewMore"
                                maxWidth="Infinity"
                                styleClass="btn-detail"
                                text="Ver más"
                                onAction="#handleViewMore"
                                disable="true"/>

                        <Button
                                fx:id="btnEditReservation"
                                maxWidth="Infinity"
                                styleClass="btn-detail"
                                text="Editar"
                                onAction="#handleModifyReservation"/>

                        <Button
                                fx:id="btnReservationConsumptions"
                                maxWidth="Infinity"
                                styleClass="btn-detail"
                                text="🛒 Consumos"
                                onAction="#handleReservationConsumptions"/>

                    </VBox>

                </content>

            </ScrollPane>

        </SplitPane>

    </VBox>

</AnchorPane>
