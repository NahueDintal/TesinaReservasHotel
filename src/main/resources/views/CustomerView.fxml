<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CustomerController">

    <VBox spacing="15" styleClass="content-main" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <!-- Título y botones -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label styleClass="section-title" text="Clientes">
                <font><Font size="24.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnNewCustomer" styleClass="btn-primary" text="Nuevo" />
            <Button fx:id="btnViewInactive" styleClass="btn-secondary" text="📁 Eliminados" />
        </HBox>

        <!-- Buscador -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <TextField fx:id="txtSearch" promptText="🔍 Buscar por nombre, apellido, email, teléfono..." styleClass="search-field" HBox.hgrow="ALWAYS" />
            <!-- Para despues -->
            <!--<Button text="Limpiar filtros" onAction="#clearFilters" styleClass="btn-secondary" />-->
            <!--<Button text="📤 Exportar" styleClass="btn-secondary" />-->
        </HBox>

        <!-- SplitPane: Tabla + Detalle -->
        <SplitPane dividerPositions="0.75" styleClass="split-pane" VBox.vgrow="ALWAYS">
            <VBox spacing="10">
                <TableView fx:id="tableCustomers" styleClass="customer-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFirstName" prefWidth="120" text="Nombres" />
                        <TableColumn fx:id="colSurname" prefWidth="120" text="Apellidos" />
                        <TableColumn fx:id="colDocumentType" prefWidth="120" text="Tipo Documento" />
                        <TableColumn fx:id="colOrigin" prefWidth="100" text="Origen" />
                        <TableColumn fx:id="colCountry" prefWidth="100" text="País" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <Label fx:id="lblTotalCustomers" styleClass="footer-info" text="Mostrando 0 clientes" />
            </VBox>

            <!-- Panel de detalle -->
            <VBox maxWidth="400.0" minWidth="150.0" prefWidth="400.0" spacing="12" styleClass="detail-panel">
                <padding>
                    <Insets bottom="15" left="15" right="15" top="15" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="Infinity">
                    <TextField fx:id="txtDetailFullName" text="Nombre Completo" styleClass="detail-value-field-name"
                               editable="false" focusTraversable="false" HBox.hgrow="ALWAYS" />
                </HBox>

                <Label text="Tipo de Documento:" styleClass="detail-label" />
                <TextField fx:id="txtDetailDocumentType" text="--" styleClass="detail-value-field" editable="false" focusTraversable="false" />

                <Label text="Número:" styleClass="detail-label" />
                <TextField fx:id="txtDetailDocumentNumber" text="--" styleClass="detail-value-field" editable="false" focusTraversable="false" maxWidth="Infinity"/>

                <Label text="Teléfono:" styleClass="detail-label" />
                <TextField fx:id="txtDetailPhone" text="--" styleClass="detail-value-field" editable="false" focusTraversable="false" maxWidth="Infinity"/>

                <Label text="Email:" styleClass="detail-label" />
                <TextField fx:id="txtDetailEmail" text="--" styleClass="detail-value-field" editable="false" focusTraversable="false" maxWidth="Infinity" />

                <Label text="País:" styleClass="detail-label" />
                <TextField fx:id="txtDetailCountry" text="--" styleClass="detail-value-field" editable="false" focusTraversable="false" maxWidth="Infinity" />

                <Label text="Origen:" styleClass="detail-label" />
                <TextField fx:id="txtDetailOrigin" text="--" styleClass="detail-value-field" editable="false" focusTraversable="false" />

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="btnEdit" maxWidth="Infinity" styleClass="btn-detail" text="Editar" />
                <Button fx:id="btnDeactivate" maxWidth="Infinity" styleClass="btn-detail-danger" text="Eliminar" />
                <!--Para despues-->
                <!--<Button text="Ver Reservas" styleClass="btn-detail" maxWidth="Infinity" />-->
            </VBox>
        </SplitPane>
    </VBox>
</AnchorPane>
