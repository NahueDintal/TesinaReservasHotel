<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.GridPane?>
<BorderPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CustomerController">

    <!-- ==================== PANEL IZQUIERDO (SIDEBAR) ==================== -->
    <left>
        <VBox styleClass="sidebar" prefWidth="280.0" spacing="5">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
            <ImageView fitHeight="80.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../images/hotel-icon.png" />
            </ImageView>
            <Label text="SISTEMA HOTEL" styleClass="sidebar-titulo" />
            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <ToggleButton text="Planilla de reserva" styleClass="sidebar-btn" />
                <ToggleButton text="Reservas" styleClass="sidebar-btn" />
                <ToggleButton text="Habitaciones" styleClass="sidebar-btn" />
                <ToggleButton text="Clientes" styleClass="sidebar-btn" style="-fx-background-color: #2E6D3D;" />
                <ToggleButton text="Reportes" styleClass="sidebar-btn" />
                <ToggleButton text="Configuración" styleClass="sidebar-btn" />
            </VBox>
            <VBox spacing="5">
                <Label text="👤 Admin" styleClass="sidebar-usuario" />
                <Button text="Cerrar sesión" styleClass="sidebar-logout" />
            </VBox>
        </VBox>
    </left>

    <!-- ==================== ÁREA CENTRAL ==================== -->
    <center>
        <VBox styleClass="contenido-principal" spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>

            <!-- ===== FILA 1: TÍTULO + BOTÓN NUEVO CLIENTE ===== -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Clientes" styleClass="titulo-seccion">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnAdd" text="+ Nuevo Cliente" styleClass="btn-primario" />
            </HBox>

            <!-- ===== FILA 2: BARRA DE BÚSQUEDA + FILTRO ===== -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="🔍 Buscar por nombre, email, teléfono..." styleClass="campo-busqueda" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="comboFiltroEstado" promptText="Filtrar por estado" styleClass="combo-filtro" />
                <Button text="📤 Exportar" styleClass="btn-secundario" />
            </HBox>

            <!-- ===== FILA 3: SPLITPANE (LISTA + DETALLE) ===== -->
            <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS">
                <!-- LADO IZQUIERDO: TABLA DE CLIENTES -->
                <VBox spacing="10">
                    <TableView fx:id="tableCustomers" styleClass="tabla-clientes" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                            <TableColumn fx:id="colName" text="Nombre" prefWidth="120" />
                            <TableColumn fx:id="colSurname" text="Apellido" prefWidth="120" />
                            <TableColumn fx:id="colDocument" text="DNI" prefWidth="100" />
                            <TableColumn fx:id="colPhone" text="Teléfono" prefWidth="110" />
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="150" />
                            <TableColumn fx:id="colStatus" text="Estado" prefWidth="90" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                    <Label fx:id="lblTotalClientes" text="Mostrando 0 clientes" styleClass="info-pie" />
                </VBox>

                <!-- LADO DERECHO: PANEL DE DETALLE DEL CLIENTE -->
                <VBox spacing="15" styleClass="panel-detalle">
                    <padding>
                        <Insets top="10" right="15" bottom="10" left="15" />
                    </padding>

                    <!-- Cabecera del detalle -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="lblDetalleNombre" text="Nombre Apellido" styleClass="detalle-nombre" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblDetalleEstado" text="Activo" styleClass="detalle-estado" />
                    </HBox>
                    <Label fx:id="lblDetalleId" text="ID: 001" styleClass="detalle-id" />

                    <Separator />

                    <!-- Información Personal -->
                    <Label text="Información Personal" styleClass="detalle-seccion" />
                    <GridPane hgap="15" vgap="8">
                        <Label text="DNI:" styleClass="detalle-etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="lblDetalleDni" text="--" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Fecha de Nacimiento:" styleClass="detalle-etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="lblDetalleFechaNac" text="--" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Género:" styleClass="detalle-etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="lblDetalleGenero" text="--" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Nacionalidad:" styleClass="detalle-etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label fx:id="lblDetalleNacionalidad" text="--" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    </GridPane>

                    <!-- Contacto -->
                    <Label text="Contacto" styleClass="detalle-seccion" />
                    <GridPane hgap="15" vgap="8">
                        <Label text="Teléfono Celular:" styleClass="detalle-etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="lblDetalleCelular" text="--" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Teléfono Fijo:" styleClass="detalle-etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="lblDetalleFijo" text="--" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Email:" styleClass="detalle-etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="lblDetalleEmail" text="--" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Dirección:" styleClass="detalle-etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label fx:id="lblDetalleDireccion" text="--" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Ciudad:" styleClass="detalle-etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <Label fx:id="lblDetalleCiudad" text="--" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label text="Provincia:" styleClass="detalle-etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <Label fx:id="lblDetalleProvincia" text="--" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    </GridPane>

                    <!-- Acciones -->
                    <Label text="Acciones" styleClass="detalle-seccion" />
                    <HBox spacing="15">
                        <Button text="✏️ Editar Cliente" styleClass="btn-detalle" />
                        <Button text="🚫 Inactivar Cliente" styleClass="btn-detalle-peligro" />
                        <Button text="📋 Ver Historial" styleClass="btn-detalle" />
                    </HBox>
                </VBox>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>