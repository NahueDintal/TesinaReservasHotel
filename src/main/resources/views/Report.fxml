<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="content-main" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ReportController">

    <!-- ============ CENTER: dashboard de tarjetas + panel inferior ============ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="dashboard-scroll" hbarPolicy="NEVER">
            <VBox spacing="18" styleClass="dashboard-content">
                <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

                <!-- ======== ENCABEZADO ======== -->
                <VBox spacing="4">
                    <Label styleClass="section-title" text="Reportes" />
                    <Label styleClass="subtitulo-seccion" text="Selecciona un reporte para ver su análisis detallado." />
                </VBox>

                <!-- ======== GRID DE TARJETAS ======== -->
                <GridPane hgap="18" vgap="18" fx:id="cardsGrid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS" />
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS" />
                        <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS" />
                    </columnConstraints>

                    <!-- Fila 1 -->
                    <VBox fx:id="tileCancellationProbability" styleClass="report-tile"
                          style="-fx-background-color: white; -fx-border-color: #d0d7d2; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 18; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                          GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="10">
                        <Label styleClass="report-tile-icon" text="📊" />
                        <Label styleClass="report-tile-title" text="Probabilidad de cancelación" />
                        <Label styleClass="report-tile-desc" text="Análisis empírico P(cancelar | canal) con intervalos de confianza." wrapText="true" />
                    </VBox>

                    <VBox fx:id="tileCancellationByLeadTime" styleClass="report-tile"
                          style="-fx-background-color: white; -fx-border-color: #d0d7d2; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 18; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                          GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="10">
                        <Label styleClass="report-tile-icon" text="⏳" />
                        <Label styleClass="report-tile-title" text="Cancelación por anticipación" />
                        <Label styleClass="report-tile-desc" text="Días de antelación con los que se cancelan las reservas." wrapText="true" />
                    </VBox>

                    <VBox fx:id="tileCancellationByMonth" styleClass="report-tile"
                          style="-fx-background-color: white; -fx-border-color: #d0d7d2; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 18; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                          GridPane.columnIndex="2" GridPane.rowIndex="0" spacing="10">
                        <Label styleClass="report-tile-icon" text="📅" />
                        <Label styleClass="report-tile-title" text="Cancelación por mes" />
                        <Label styleClass="report-tile-desc" text="Evolución mensual de las cancelaciones en el período." wrapText="true" />
                    </VBox>

                    <!-- Fila 2 -->
                    <VBox fx:id="tileCancellationImpact" styleClass="report-tile"
                          style="-fx-background-color: white; -fx-border-color: #d0d7d2; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 18; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                          GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="10">
                        <Label styleClass="report-tile-icon" text="📉" />
                        <Label styleClass="report-tile-title" text="Impacto cancelaciones" />
                        <Label styleClass="report-tile-desc" text="Pérdida estimada de ingresos por cancelaciones." wrapText="true" />
                    </VBox>

                    <VBox fx:id="tileCancellationByGuests" styleClass="report-tile"
                          style="-fx-background-color: white; -fx-border-color: #d0d7d2; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 18; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                          GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="10">
                        <Label styleClass="report-tile-icon" text="👥" />
                        <Label styleClass="report-tile-title" text="Cancelación por huéspedes" />
                        <Label styleClass="report-tile-desc" text="Comportamiento de cancelación según cantidad de huéspedes." wrapText="true" />
                    </VBox>

                    <VBox fx:id="tileCancellationByCustomerOrigin" styleClass="report-tile"
                          style="-fx-background-color: white; -fx-border-color: #d0d7d2; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 18; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                          GridPane.columnIndex="2" GridPane.rowIndex="1" spacing="10">
                        <Label styleClass="report-tile-icon" text="🌍" />
                        <Label styleClass="report-tile-title" text="Cancelación por origen" />
                        <Label styleClass="report-tile-desc" text="Distribución geográfica de las reservas canceladas." wrapText="true" />
                    </VBox>

                    <!-- Fila 3 -->
                    <VBox fx:id="tileDailySchedule" styleClass="report-tile"
                          style="-fx-background-color: white; -fx-border-color: #d0d7d2; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 18; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                          GridPane.columnIndex="0" GridPane.rowIndex="2" spacing="10">
                        <Label styleClass="report-tile-icon" text="🗓️" />
                        <Label styleClass="report-tile-title" text="Cronograma diario" />
                        <Label styleClass="report-tile-desc" text="Check-ins y check-outs programados para una fecha." wrapText="true" />
                    </VBox>

                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>

                <!-- ======== PANEL INFERIOR CON REPORTE EMBEBIDO ======== -->
                <VBox spacing="0" styleClass="report-embed-panel">
                    <AnchorPane fx:id="centerPane" styleClass="report-embed-content" />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
