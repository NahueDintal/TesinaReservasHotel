<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ReportController">

    <!-- ============ LEFT: menu ============ -->
    <left>
        <VBox fx:id="leftMenu" prefHeight="3506.0" prefWidth="227.0" spacing="6" style="-fx-background-color: #1f2937; -fx-padding: 18 12 18 12;">

            <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" text="Reports" />
            <Label style="-fx-font-size: 11; -fx-text-fill: #9ca3af;" text="Analytics &amp; statistics" />

            <Region prefHeight="14" />

            <ToggleButton fx:id="btnCancellationProbability" alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-padding: 10 12 10 12;" text="Probabilidad de cancelación" />
            <ToggleButton fx:id="btnCancellationByLeadTime" alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-padding: 10 12 10 12;" text="Cancelación por anticipación" />
            <ToggleButton fx:id="btnCancellationByMonth" alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-padding: 10 12 10 12;" text="Cancelación por mes" />
            <ToggleButton fx:id="btnCancellationImpact" alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-padding: 10 12 10 12;" text="Impacto cancelaciones" />
            <ToggleButton fx:id="btnCancellationByGuests"
                          text="Cancelación por huéspedes"
                          maxWidth="Infinity" alignment="CENTER_LEFT"
                          style="-fx-padding: 10 12 10 12;"/>
            <ToggleButton fx:id="btnCancellationByCustomerOrigin"
                          text="Cancelación por origen"
                          maxWidth="Infinity" alignment="CENTER_LEFT"
                          style="-fx-padding: 10 12 10 12;"/>
            <ToggleButton fx:id="btnDailySchedule"
                          text="Cronograma diario"
                          maxWidth="Infinity" alignment="CENTER_LEFT"
                          style="-fx-padding: 10 12 10 12;"/>
        </VBox>
    </left>

    <!-- ============ CENTER: dynamic sub-report ============ -->
    <center>
        <AnchorPane fx:id="centerPane" style="-fx-background-color: #f4f6f9;" />
    </center>
</BorderPane>
