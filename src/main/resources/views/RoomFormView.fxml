<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20" styleClass="form-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.RoomFormController">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25" />
    </padding>

    <Label fx:id="lblFormTitle" text="Nueva Habitación" styleClass="form-title">
        <font><Font size="20.0" /></font>
    </Label>

    <GridPane hgap="15" vgap="12">
        <Label text="Número *" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtNumber" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="150.0" />

        <Label text="Piso *" styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtFloor" GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="150.0" />

        <Label text="Tipo *" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="comboType" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="150.0" />

        <Label text="Capacidad *" styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtCapacity" GridPane.columnIndex="3" GridPane.rowIndex="1" prefWidth="150.0" />

        <Label text="Vista *" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="comboView" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="150.0" />

        <Label text="Precio *" styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <TextField fx:id="txtPrice" GridPane.columnIndex="3" GridPane.rowIndex="2" prefWidth="150.0" />

        <Label text="Características *" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtFeatures" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="250.0" GridPane.columnSpan="3" />

        <Label text="Descripción" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="txtDescription" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="250.0" GridPane.columnSpan="3" />
    </GridPane>

    <Region VBox.vgrow="ALWAYS" />

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancel" text="Cancelar" styleClass="btn-secondary" />
        <Button fx:id="btnSave" text="Guardar" styleClass="btn-primary" />
    </HBox>
</VBox>
