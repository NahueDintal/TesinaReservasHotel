<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DashboardController">

    <!-- ==================== SIDEBAR ==================== -->
    <left>
        <VBox styleClass="sidebar" prefWidth="280.0" spacing="5">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>

            <ImageView fitHeight="80.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../images/hotel-icon.png" />
            </ImageView>
            <Label text="SISTEMA HOTEL" styleClass="sidebar-titulo" />

            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <ToggleButton fx:id="btnPlanilla" text="Planilla de reserva" styleClass="sidebar-btn" />
                <ToggleButton fx:id="btnReservas" text="Reservas" styleClass="sidebar-btn" />
                <ToggleButton fx:id="btnHabitaciones" text="Habitaciones" styleClass="sidebar-btn" />
                <ToggleButton fx:id="btnClientes" text="Clientes" styleClass="sidebar-btn" />
                <ToggleButton fx:id="btnReportes" text="Reportes" styleClass="sidebar-btn" />
                <ToggleButton fx:id="btnConfiguracion" text="Configuración" styleClass="sidebar-btn" />
            </VBox>

            <VBox spacing="5">
                <Label text="👤 Admin" styleClass="sidebar-usuario" />
                <Button text="Cerrar sesión" styleClass="sidebar-logout" />
            </VBox>
        </VBox>
    </left>

    <!-- ==================== ÁREA CENTRAL ==================== -->
    <center>
        <AnchorPane fx:id="centerPane"
                    BorderPane.alignment="TOP_RIGHT" />
    </center>
</BorderPane>